#include <iostream>
#include <windows.h>
#include <conio.h>
#include <unistd.h> // Untuk sleep jika diperlukan

using namespace std;

// Fungsi gotoxy untuk mengatur posisi kursor di console (x, y)
void gotoxy(int x, int y) {
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

// Fungsi load animasi sederhana (jika ingin dipakai)
void load() {
    system("cls");
    system("COLOR F8");
    cout << "LOADING ";
    sleep(1);
    for (int x = 0; x < 5; x++) {
        cout << "*";
        sleep(1);
    }
    cout << "\33[2K\r";
    system("cls");
}

// Fungsi untuk menampilkan panah "==>" pada posisi menu yang aktif
void panah(int posisi_pilihan, int posisi_arrow) {
    if (posisi_pilihan == posisi_arrow) {
        cout << "==>";
    } else {
        cout << "   ";
    }
}

// Deklarasi fungsi menu 1 sampai menu 5
void menu1() {
    system("cls");
    system("COLOR F8");
    cout << "Halo Adikkss :v \n";
    system("pause");
}

void menu2() {
    system("cls");
    system("COLOR F8");
    cout << "Hai Dunia Gembiralah :D \n";
    system("pause");
}

void menu3() {
    system("cls");
    system("COLOR F8");
    cout << "Selamat Hari Jumat, GBU :3 \n";
    system("pause");
}

void menu4() {
    system("cls");
    system("COLOR F8");
    cout << "Jangan lupa makan, kesehatanmu loo :p \n";
    system("pause");
}

void menu5() {
    system("cls");
    system("COLOR F8");
    cout << "Udah weh pulang sana :'v \n";
    system("pause");
}

int main() {
    int posisi = 1;
    int tekan = 0;

    // Array pointer fungsi untuk menu memudahkan pemanggilan fungsi sesuai pilihan
    void (*menuPointer[5])() = {menu1, menu2, menu3, menu4, menu5};

MENU_START:   // Label goto untuk kembali ke menu utama
    system("cls");
    system("COLOR F8");

    gotoxy(2, 2);
    cout << "===========================";
    gotoxy(2, 3);
    cout << "Tugas Quiz Stack and Queue";
    gotoxy(2, 4);
    cout << "===========================";

    // Loop menampilkan menu dan navigasi panah
    while(tekan != 13) {  // Enter = 13
        for(int i = 1; i <= 5; i++) {
            gotoxy(2, 4 + i);
            panah(i, posisi);
            cout << " " << i << ". Menu " << i << "\n";
        }

        tekan = getch();   // Ambil input karakter tanpa menunggu enter
        if (tekan == 80 && posisi < 5) {     // Panah bawah
            posisi++;
        } else if (tekan == 72 && posisi > 1) { // Panah atas
            posisi--;
        }
    }

    // Panggil fungsi menu yang dipilih menggunakan pointer fungsi
    (*menuPointer[posisi - 1])();

    // Kembali ke menu utama dengan goto
    goto MENU_START;

    return 0;
}
