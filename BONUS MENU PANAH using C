<============================ Kode Program 2 (memanggil Goto dari Main) ============================>
#include <stdio.h>
#include <windows.h>
#include <stdlib.h>
#include <conio.h>

// Fungsi gotoxy untuk mengatur posisi kursor pada console (x, y)
// Menggunakan fungsi Windows API SetConsoleCursorPosition
void gotoxy(int x, int y){
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

// Fungsi load untuk menampilkan animasi loading sederhana
void load(){
    int x, waktu;
    system("cls");      // Bersihkan layar
    system("COLOR F8"); // Set warna console
    printf("LOADING ");
    sleep(1);
    for(waktu=0; waktu<=0; waktu++){  // Loop ini hanya satu kali
        for(x=0; x<5; x++){
            printf("*");  // Print bintang satu per satu
            sleep(1);    // Pause selama 1 detik
        }
        printf("\33[2K\r"); // Clear line dan kembalikan cursor ke awal baris (ANSI escape)
    }
    system("cls");  // Bersihkan layar kembali setelah loading
    return;
}

// Fungsi panah untuk menampilkan tanda panah "==>" di sebelah menu yang sedang dipilih
void panah(int rp, int ap){
    if(rp == ap){
        printf("==>");   // Jika posisi pilihan (rp) sama dengan posisi panah (ap), tampilkan panah
    } else {
        printf("   ");   // Jika tidak, tampilkan spasi kosong
    }
}

// Fungsi utama program dengan pointer menu dan penggunaan goto untuk loop menu
int main() {
    int posisi = 1;  // Posisi menu yang sedang dipilih, awalnya 1
    int tekan = 0;   // Variabel untuk menyimpan input tombol keyboard

    // Array pointer ke fungsi menu, memudahkan menggunakan pointer fungsi
    void (*menuPointer[5])() = {menu1, menu2, menu3, menu4, menu5};

MENU_START:   // Label untuk goto agar kembali ke menu utama
    system("cls");
    system("COLOR F8");
    gotoxy(2, 2);
    printf("===========================");
    gotoxy(2, 3);
    printf("Tugas Quiz Stack and Queue");
    gotoxy(2, 4);
    printf("===========================");

    // Tampilkan menu dengan panah di samping sesuai posisi pilihan
    while(tekan != 13) {   // 13 = tombol Enter (Carriage Return)
        for(int i = 1; i <= 5; i++){
            gotoxy(2, 4 + i);
            panah(i, posisi);  // Tampilkan tanda panah di menu yang aktif (berposisi)
            printf(" %d. Menu %d\n", i, i);
        }

        tekan = getch();   // Ambil input karakter tanpa menunggu enter
        if(tekan == 80 && posisi < 5){  
            posisi++;   // Tombol panah bawah (ASCII 80) naikkan posisi menu
        } else if(tekan == 72 && posisi > 1){
            posisi--;   // Tombol panah atas (ASCII 72) turunkan posisi menu
        }
    }

    // Panggil fungsi menu sesuai posisi yang dipilih menggunakan pointer fungsi
    (*menuPointer[posisi - 1])();
    goto MENU_START;  // Kembali ke label menu utama setelah fungsi menu selesai

    return 0;
}

