// Fungsi gotoxy untuk mengatur posisi cursor pada console
void gotoxy(int x, int y){
    COORD coord;           // Membuat variabel koordinat console
    coord.X = x;           // Set posisi X
    coord.Y = y;           // Set posisi Y
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord); // Pindahkan cursor ke posisi (x,y)
}

