#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <conio.h>    // For getch() - Windows specific
#include <windows.h>  // For gotoxy() cursor positioning (optional)

// Define maximum items that can be stored
#define MAX_ITEMS 100

// Define a struct to hold an item record
typedef struct {
    int id;
    char name[50];
    char description[100];
} Item;

// Global array of items and count
Item items[MAX_ITEMS];
int itemCount = 0;

// Function to move cursor to a specific position on console (Windows only)
void gotoxy(int x, int y) {
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

// Function prototypes
void menu();
void addItem();
void displayItems();
void searchItem();
void updateItem();
void deleteItem();
void clearInputBuffer();

int main() {
    menu();
    return 0;
}

// Menu function to display options and handle user choice
void menu() {
    int choice;

    do {
        system("cls");  // Clear screen

        printf("===== CRUD Program Menu =====\n");
        printf("1. Add Item\n");
        printf("2. Display All Items\n");
        printf("3. Search Item\n");
        printf("4. Update Item\n");
        printf("5. Delete Item\n");
        printf("6. Exit\n");
        printf("=============================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        clearInputBuffer();

        switch(choice) {
            case 1:
                addItem();
                break;
            case 2:
                displayItems();
                break;
            case 3:
                searchItem();
                break;
            case 4:
                updateItem();
                break;
            case 5:
                deleteItem();
                break;
            case 6:
                printf("Exiting program...\n");
                break;
            default:
                printf("Invalid choice! Please try again.\n");
                system("pause");
        }
    } while(choice != 6);
}

// Adds a new item to the array
void addItem() {
    if (itemCount >= MAX_ITEMS) {
        printf("Item list is full. Cannot add more items.\n");
        system("pause");
        return;
    }

    printf("\nEnter ID: ");
    scanf("%d", &items[itemCount].id);
    clearInputBuffer();

    printf("Enter Name: ");
    fgets(items[itemCount].name, sizeof(items[itemCount].name), stdin);
    items[itemCount].name[strcspn(items[itemCount].name, "\n")] = 0;  // Remove newline

    printf("Enter Description: ");
    fgets(items[itemCount].description, sizeof(items[itemCount].description), stdin);
    items[itemCount].description[strcspn(items[itemCount].description, "\n")] = 0;

    itemCount++;
    printf("Item added successfully!\n");
    system("pause");
}

// Displays all stored items in a formatted way
void displayItems() {
    if (itemCount == 0) {
        printf("\nNo items to display.\n");
    } else {
        printf("\n\tID\tName\t\tDescription\n");
        printf("\t-------------------------------------------------\n");
        for (int i = 0; i < itemCount; i++) {
            printf("\t%d\t%s\t\t%s\n", items[i].id, items[i].name, items[i].description);
        }
    }
    system("pause");
}

// Searches for an item by ID and displays it
void searchItem() {
    int searchId, found = 0;
    printf("\nEnter ID to search: ");
    scanf("%d", &searchId);
    clearInputBuffer();

    for (int i = 0; i < itemCount; i++) {
        if (items[i].id == searchId) {
            printf("Item found:\n");
            printf("ID: %d\nName: %s\nDescription: %s\n", items[i].id, items[i].name, items[i].description);
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Item with ID %d not found.\n", searchId);
    }
    system("pause");
}

// Updates an item based on ID
void updateItem() {
    int updateId, found = 0;
    printf("\nEnter ID to update: ");
    scanf("%d", &updateId);
    clearInputBuffer();

    for (int i = 0; i < itemCount; i++) {
        if (items[i].id == updateId) {
            printf("Enter new name: ");
            fgets(items[i].name, sizeof(items[i].name), stdin);
            items[i].name[strcspn(items[i].name, "\n")] = 0;

            printf("Enter new description: ");
            fgets(items[i].description, sizeof(items[i].description), stdin);
            items[i].description[strcspn(items[i].description, "\n")] = 0;

            printf("Item updated successfully.\n");
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Item with ID %d not found.\n", updateId);
    }
    system("pause");
}

// Deletes an item based on ID by shifting array elements down
void deleteItem() {
    int deleteId, found = 0;
    printf("\nEnter ID to delete: ");
    scanf("%d", &deleteId);
    clearInputBuffer();

    for (int i = 0; i < itemCount; i++) {
        if (items[i].id == deleteId) {
            // Shift all later items one step back
            for (int j = i; j < itemCount -1; j++) {
                items[j] = items[j + 1];
            }
            itemCount--;
            printf("Item deleted successfully.\n");
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Item with ID %d not found.\n", deleteId);
    }
    system("pause");
}

// Clears stdin buffer to avoid issues after scanf
void clearInputBuffer() {
    while (getchar() != '\n');
}
