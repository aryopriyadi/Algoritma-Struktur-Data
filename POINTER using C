<======================= KODE PROGRAM 2 =======================>
#include <stdio.h>
#include <stdlib.h> // Diperlukan untuk fungsi malloc, calloc, realloc, dan free

int main() {
    // Mendeklarasikan array statis dan pointer ke elemen pertama array
    int array[] = {3, 2, 5, 6, 1};
    int *p_array = &array[0]; // Pointer menunjuk ke elemen pertama array

    // Menampilkan seluruh isi array menggunakan pointer aritmatika
    for (int i = 0; i < 5; i++) {
        printf("%d ", *(p_array + i));
    }
    printf("\n");

    // Mengubah nilai elemen pertama array melalui pointer
    *p_array = 10;

    // Mengalokasikan memory secara dinamis untuk 5 elemen int
    int *ps = (int *)malloc(5 * sizeof(int));
    if (ps == NULL) { // Pemeriksaan keberhasilan malloc
        printf("Gagal mengalokasikan memori\n");
        exit(1);
    }
    // Inisialisasi nilai elemen array dinamis
    for (int i = 0; i < 5; i++) {
        ps[i] = i + 1;
    }

    // Mengalokasikan memori menggunakan calloc, yang otomatis menginisialisasi ke 0
    int *p_calloc = (int *)calloc(5, sizeof(int));
    if (p_calloc == NULL) { // Pemeriksaan keberhasilan calloc
        printf("Memory not allocated\n");
        exit(1);
    }
    // Mengisi nilai pada array yang dialokasikan dengan calloc
    for (int i = 0; i < 5; i++) {
        p_calloc[i] = i + 1;
    }

    // Melepaskan alokasi memori calloc
    free(p_calloc);

    // free tidak boleh diterapkan untuk array statis seperti p_array
    // free(p_array); // Ini salah dan harus dihindari

    // Mengubah ukuran alokasi memori ps menjadi 10 elemen (realloc)
    ps = realloc(ps, 10 * sizeof(int));

    // Menginisialisasi elemen baru setelah ukuran diubah
    for (int i = 5; i < 10; i++) {
        ps[i] = i + 1;
    }
    printf("\n");

    // Menampilkan seluruh isi array dinamis yang telah diperluas
    for (int i = 0; i < 10; i++) {
        printf("%d ", ps[i]);
    }
    printf("\n");

    // Menampilkan ukuran pointer dan array menggunakan sizeof
    printf("Ukuran ps: %zu\n", sizeof(ps));           // Ukuran pointer (biasanya 4 atau 8 bytes tergantung platform)
    printf("Ukuran p_calloc: %zu\n", sizeof(p_calloc)); // Ukuran pointer
    printf("Ukuran array: %zu\n", sizeof(array));       // Ukuran array keseluruhan (jumlah elemen * ukuran int)

    // Menampilkan nilai dan alamat dengan pointer
    printf("Nilai p_array[1]: %d, alamat pointer p_array: %p, alamat ps: %p\n", *(p_array + 1), (void*)&p_array, (void*)&ps);

    // Melepaskan memori ps sebelum program selesai
    free(ps);

    return 0;
}
