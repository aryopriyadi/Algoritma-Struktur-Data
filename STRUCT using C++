#include <iostream>
#include <string>
using namespace std;

// Mendefinisikan struct zodiak dengan nama dan rentang tanggal/bulan
struct Zodiak {
    string nama;
    int tgl_awal;
    int bln_awal;
    int tgl_akhir;
    int bln_akhir;
};

int main() {
    Zodiak bintang = {"Scorpio", 23, 10, 21, 11};  // Inisialisasi struct Zodiak Scorpio

    int tgl_lahir, bln_lahir, thn_lahir;

    cout << "Masukkan tanggal lahir Anda (d m y): ";
    cin >> tgl_lahir >> bln_lahir >> thn_lahir;

    // Memeriksa apakah tanggal lahir masuk dalam rentang zodiak Scorpio
    if ((tgl_lahir >= bintang.tgl_awal && bln_lahir == bintang.bln_awal) || 
        (tgl_lahir <= bintang.tgl_akhir && bln_lahir == bintang.bln_akhir)) {
        cout << "Bintang Anda adalah " << bintang.nama << endl;
    } else {
        cout << "Bintang Anda bukan " << bintang.nama << endl;
    }

    return 0;
}

