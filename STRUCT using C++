#include <iostream>
#include <string>
using namespace std;

// Mendefinisikan struct Address yang berisi kota dan nomor rumah
struct Address {
    string kota;
    int noRumah;
};

// Mendefinisikan struct Mahasiswa yang memiliki nama, nim, dan alamat bertipe Address
struct Mahasiswa {
    string nama;
    int nim;
    Address addr;
};

int main() {
    // Contoh penggunaan typedef (alias) untuk tipe data integer
    typedef int bilBulat;
    bilBulat c = 99;
    cout << c << endl;

    // Deklarasi array struct Mahasiswa
    Mahasiswa m3[2];
    m3[0].nama = "anton";               // Mengisi nama mahasiswa ke-0
    m3[0].nim = 12345;                  // Mengisi nim mahasiswa ke-0
    cout << "\n" << m3[0].nama;
    cout << "\nNIM: " << m3[0].nim << endl;

    Mahasiswa m1;
    m1.nama = "memet";                  // Mengisi nama mahasiswa
    m1.nim = 672021021;                 // Mengisi nim mahasiswa
    m1.addr.kota = "Solo";              // Mengisi kota di alamat
    m1.addr.noRumah = 456;              // Mengisi nomor rumah di alamat

    cout << "\nNama: " << m1.nama << endl;
    cout << "NIM: " << m1.nim << endl;
    cout << "Asal Kota: " << m1.addr.kota << endl;
    cout << "Nomor Rumah: " << m1.addr.noRumah << endl;

    return 0;
}
