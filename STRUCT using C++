#include <iostream>
#include <string>
using namespace std;

// Mendefinisikan struct Jurusan yang berisi prodi dan peminatan sebagai string
struct Jurusan {
    string prodi;
    string peminatan;
};

// Mendefinisikan typedef struct Mahasiswa dengan anggota nama, nim, dan jurusan
struct Mahasiswa {
    string nama;
    long nim;
    Jurusan jurusan;
};

// Fungsi untuk menampilkan data mahasiswa yang diterima sebagai array
void tampilkan(const Mahasiswa mhs[], int size) {
    for(int i = 0; i < size; i++) {
        cout << "\nData Mahasiswa Ke-" << i + 1 << endl;
        cout << "Nama : " << mhs[i].nama << endl;
        cout << "NIM  : " << mhs[i].nim << endl;
        cout << "Prodi: " << mhs[i].jurusan.prodi << endl;
        cout << "Peminatan: " << mhs[i].jurusan.peminatan << endl;
    }
}

int main() {
    const int MAX = 3;  // Konstanta jumlah mahasiswa
    Mahasiswa mhs[MAX];

    //    mhs.nama = "Aryo";
    //    strcpy(mhs.nama, "Aryo");
    //    mhs.nim = 672021121;

    for (int i = 0; i < MAX; i++) {
        cout << "Data Mahasiswa Ke-" << i+1 << endl;

        cout << "Masukkan Nama: ";
        getline(cin, mhs[i].nama);  // Menggunakan getline agar bisa input dengan spasi

        cout << "Masukkan NIM: ";
        cin >> mhs[i].nim;
        cin.ignore();  // Menghilangkan newline yang tertinggal setelah input NIM

        cout << "Masukkan Prodi: ";
        getline(cin, mhs[i].jurusan.prodi);

        cout << "Masukkan Peminatan: ";
        getline(cin, mhs[i].jurusan.peminatan);
    }

    tampilkan(mhs, MAX);

    return 0;
}

