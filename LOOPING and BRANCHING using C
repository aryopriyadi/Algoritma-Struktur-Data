#include <stdio.h>
#include <stdlib.h>
#include <conio.h>
#include <windows.h>

void gotoxy(int x, int y){//fungsi goto untuk dipanggil ke main
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE),coord);
}

int main(){
    int i, j, n, m;
    do{
        printf("1. menu 1\n");
        printf("2. menu 2\n");
        printf("input pilihan : ");
        scanf("%d",&n);
        switch(n){
            case 1:
                system("cls");
                printf("Masukan input : ");
                scanf("%d",&m);
                for(i=0; i<=m; i++){
                    for(j=1; j<=i; j++){
                        printf("*");
                    }printf("\n");
                }break;
            case 2:
                system("cls");
                printf("ini menu 2\n");
                break;
            default :
                continue;
        }
    }while(n != 3);
}


